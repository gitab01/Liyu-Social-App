rules_version = '2';

// Authorization for the whole app lives here: there is no server tier, so these
// rules ARE the access layer. Every predicate mirrors a method on AccessRules in
// lib/domain/access_rules.dart — keep the two in lockstep, an emulator test that
// disagrees with the Dart predicates is a real authorization bug.
//
// One constraint shapes every read rule below: a broad Firestore `list` runs its
// rule per returned document, and every get/exists spends a small per-request
// budget. So the wide scans — the public feed and the inbox — are kept to pure
// field checks (`audience == 'everyone'`, `authUid() in participantUids`), and a
// followers-only post is authorized where it is actually opened, the document
// `get`, which can afford the follower + block reads. AccessRules is the source of
// truth for those decisions; `list` simply never returns rows whose fuller `get`
// rule would deny them. The one deliberate exception is the story rail: it is a
// short, author-bounded list, so it does run an `exists()` follower check inline
// (see canReadStoryForList and the comment on it).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers (shared vocabulary for the predicates) --------------------
    function signedIn() {
      return request.auth != null;
    }

    function authUid() {
      return request.auth.uid;
    }

    function userDoc(p) {
      return /databases/$(database)/documents/users/$(p);
    }

    // A follow edge is keyed `${follower}_${following}`, which makes it a single
    // document and lets membership be one `exists` call.
    function followDoc(follower, target) {
      return /databases/$(database)/documents/follows/$(follower + '_' + target);
    }

    function isFollowing(follower, target) {
      return exists(followDoc(follower, target));
    }

    // The author's and viewer's own block lists. A block hides content in both
    // directions, matching AccessRules (viewerBlocking.contains(author) ||
    // authorBlocking.contains(viewer)).
    function blockingOf(p) {
      let ref = userDoc(p);
      return !exists(ref) ? [] : ('blocking' in get(ref).data ? get(ref).data.blocking : []);
    }

    function notBlocked(a, b) {
      let aBlocks = blockingOf(a);
      let bBlocks = blockingOf(b);
      return !aBlocks.contains(b) && !bBlocks.contains(a);
    }

    // AccessRules.canReadPost, expressed for a single document. Anonymous reads
    // are allowed for `audience == 'everyone'` because that is what the Dart
    // predicate does (`viewerUid == null` still sees public posts, and the feed is
    // browsable before sign-in) — a signed-in reader is only required for the
    // follower-scoped branch, where the identity is what the check needs.
    function canReadPost(author, audience) {
      return !signedIn()
        ? audience == 'everyone'
        : author == authUid()
          ? true
          : notBlocked(authUid(), author)
            && (audience == 'everyone' || isFollowing(authUid(), author));
    }

    // AccessRules.canReadStory: followers-only, and dead once expired.
    function canReadStory(author, expiresAt) {
      return signedIn()
        && expiresAt > request.now
        && (author == authUid() || isFollowing(authUid(), author))
        && notBlocked(authUid(), author);
    }

    // The story rail is a live `list`, and a list may not spend its per-request
    // get/exists budget on the two block-list reads `notBlocked` needs. It keeps
    // the follower + expiry decision (which is what AccessRules adds on top of a
    // public feed) and defers the bidirectional block check to the document `get`
    // and the app's in-memory block set. Scale path: a per-viewer fan-out collection.
    function canReadStoryForList(author, expiresAt) {
      return signedIn()
        && expiresAt > request.now
        && (author == authUid() || isFollowing(authUid(), author));
    }

    // The server-owned counters. A client may read them and write their zero
    // default on create, but an update that moves one is rejected — only Cloud
    // Functions (which bypass rules via the Admin SDK) maintain them.
    function postCountersUnchanged() {
      return request.resource.data.likesCount == resource.data.likesCount
        && request.resource.data.commentsCount == resource.data.commentsCount;
    }

    function postCountersAtZero() {
      return (!('likesCount' in request.resource.data) || request.resource.data.likesCount == 0)
        && (!('commentsCount' in request.resource.data) || request.resource.data.commentsCount == 0);
    }

    function userCountersUnchanged() {
      return request.resource.data.followersCount == resource.data.followersCount
        && request.resource.data.followingCount == resource.data.followingCount
        && request.resource.data.postsCount == resource.data.postsCount;
    }

    function userCountersAtZero() {
      return (!('followersCount' in request.resource.data) || request.resource.data.followersCount == 0)
        && (!('followingCount' in request.resource.data) || request.resource.data.followingCount == 0)
        && (!('postsCount' in request.resource.data) || request.resource.data.postsCount == 0);
    }

    // ---- users --------------------------------------------------------------
    match /users/{uid} {
      // Profiles are visible to any signed-in user (AccessRules.canReadProfile
      // requires a viewer; per-block filtering happens on read in the app, which
      // already holds the reader's block set).
      allow get, list: if signedIn();

      // Only ever your own document, and counters must start at zero.
      allow create: if signedIn() && authUid() == uid && userCountersAtZero();
      allow update: if signedIn() && authUid() == uid && userCountersUnchanged();

      // Accounts are not hard-deleted by a client; a deactivate flow is a
      // server-side operation.
      allow delete: if false;
    }

    // ---- posts --------------------------------------------------------------
    match /posts/{postId} {
      allow get: if canReadPost(resource.data.authorUid, resource.data.audience);

      // The feed scan: public posts only, and readable without a session for
      // exactly the reason the `get` rule allows it. Followers-only posts surface
      // through the document `get` above, never through a list.
      allow list: if resource.data.audience == 'everyone';

      // Author-owned writes (AccessRules.canWritePost). A client may change the
      // caption/media/audience of its own post but never the counters. The two
      // shape checks are not policy: a `postId` that disagrees with its own path
      // breaks cursor paging, and an audience string outside the enum would make
      // the post invisible to both the feed scan and the follower check.
      allow create: if signedIn()
        && request.resource.data.authorUid == authUid()
        && request.resource.data.postId == postId
        && request.resource.data.audience in ['everyone', 'followers']
        && postCountersAtZero();
      allow update: if signedIn()
        && resource.data.authorUid == authUid()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.audience in ['everyone', 'followers']
        && postCountersUnchanged();
      allow delete: if signedIn() && resource.data.authorUid == authUid();

      // reactions/{uid}: one document per reader, doc id == the reader's uid.
      match /reactions/{uid} {
        // Nobody but the reactor reads their own vote. The aggregate anyone can
        // see is `posts/{postId}.likesCount`, which a Function maintains, so there
        // is no read path that lists who liked a post — and denying `list` is what
        // keeps a like history from being scraped off a document id.
        allow get: if signedIn() && uid == authUid();
        allow list: if false;

        // A reactor writes only their own row, and only for this post. The
        // `likesCount` this drives lives on the parent and is moved by Functions.
        allow create: if signedIn()
          && uid == authUid()
          && request.resource.data.uid == authUid()
          && request.resource.data.postId == postId;
        allow delete: if signedIn() && uid == authUid();

        // A reaction is toggled by create/delete, never edited in place.
        allow update: if false;
      }

      // comments/{commentId}: readable to anyone signed in; posting requires being
      // able to see the parent post (AccessRules.canCommentOn == canReadPost).
      //
      // The read stays a session check rather than a copy of the parent's audience
      // rule: watchComments is a snapshot listener, i.e. a `list`, and re-running
      // the follower + block `get`s of canReadPost for every comment in a thread
      // would multiply the per-request read budget by the thread length. The parent
      // post itself remains gated above, so a followers-only post is not readable
      // through its comments — only the reply text is.
      match /comments/{commentId} {
        allow get, list: if signedIn();

        allow create: if signedIn()
          && request.resource.data.authorUid == authUid()
          && request.resource.data.postId == postId
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data.authorUid,
                         get(/databases/$(database)/documents/posts/$(postId)).data.audience);

        // Only a comment's author may edit or remove it. The `commentsCount` on
        // the parent post is owned by Functions.
        allow update, delete: if signedIn() && resource.data.authorUid == authUid();
      }
    }

    // ---- stories ------------------------------------------------------------
    match /stories/{storyId} {
      allow get: if canReadStory(resource.data.authorUid, resource.data.expiresAt);

      // The rail is a live scan over the reader plus their followees; it uses the
      // get-free follower predicate above so it stays within Firestore's per-request
      // read budget. The bidirectional block check runs on the document `get`.
      allow list: if canReadStoryForList(resource.data.authorUid, resource.data.expiresAt);

      // AccessRules.canWriteStory: author-only mutation, expiry computed server-side
      // from the ttl the client supplied at publish.
      //
      // `expiresAt` in the future and `storyId == the document id` are shape checks,
      // not policy: the nightly cleanup query and the Storage reclaim it performs
      // both key off those two fields, and a story created already-expired would sit
      // unreadable and un-reclaimed forever.
      allow create: if signedIn()
        && request.resource.data.authorUid == authUid()
        && request.resource.data.storyId == storyId
        && request.resource.data.expiresAt > request.now;
      allow delete: if signedIn() && resource.data.authorUid == authUid();

      // The author owns the whole document (AccessRules.canWriteStory). A viewer is
      // granted exactly one mutation — adding themselves to `viewerUids` via
      // markViewed — so one reader can never edit another's story content.
      allow update: if signedIn()
        && (
          resource.data.authorUid == authUid()
          || (
            canReadStory(resource.data.authorUid, resource.data.expiresAt)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerUids'])
          )
        );
    }

    // ---- conversations ------------------------------------------------------
    match /conversations/{conversationId} {
      // Participants-only. Both the field (in the doc) and the array-contains
      // query the inbox uses are pure-field checks, so `list` is safe here.
      allow get, list: if signedIn() && authUid() in resource.data.participantUids;

      allow create: if signedIn()
        && authUid() in request.resource.data.participantUids
        && request.resource.data.conversationId == conversationId;

      // A participant may update the header: the sender bumps the preview and the
      // reader zeroes their own unread entry.
      //
      // This is deliberately not narrowed to "you may only change your own unread
      // count", which would read like the tighter rule: sending a message is the
      // *sender* incrementing the recipient's entry in the same transaction, so a
      // per-key restriction would break normal messaging. markRead zeroes only the
      // reader's own entry, and the preview fields are shared by definition.
      allow update: if signedIn() && authUid() in resource.data.participantUids;

      // Threads are not deleted by clients.
      allow delete: if false;

      match /messages/{messageId} {
        // AccessRules.canReadMessage: the two participants only. Each message
        // carries senderUid/recipientUid, so this is a field check and works in a
        // list — no per-document `get` on the parent needed.
        allow get, list: if signedIn()
          && (resource.data.senderUid == authUid() || resource.data.recipientUid == authUid());

        // Send: you may only author a message as yourself, to a recipient who is a
        // participant of this conversation, at a path equal to the message's own
        // client-minted id (the idempotency that makes a retry safe).
        allow create: if signedIn()
          && messageId == request.resource.data.messageId
          && request.resource.data.senderUid == authUid()
          && request.resource.data.conversationId == conversationId
          && authUid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;

        // A retry is the same document written twice, so an *update* here is not a
        // content change: Firestore evaluates a merge write whose first attempt did
        // land as an update, and rejecting it would break the idempotency the whole
        // offline send design rests on. Allowed only as an exact replay — an empty
        // diff — by the original sender.
        allow update: if signedIn()
          && request.resource.data.senderUid == authUid()
          && messageId == request.resource.data.messageId
          && request.resource.data.diff(resource.data).affectedKeys().size() == 0;

        // Delivered/read transitions are written by Functions, not peers.
        allow delete: if false;
      }
    }

    // ---- follows ------------------------------------------------------------
    match /follows/{edgeId} {
      // Edges are not secret (who follows whom is public profile data).
      allow get, list: if signedIn();

      // AccessRules.canWriteFollowEdge: you own your own outgoing edge, and the
      // document id must be exactly `${follower}_${following}` so the edge cannot
      // be forged or duplicated.
      allow create: if signedIn()
        && request.resource.data.followerUid == authUid()
        && request.resource.data.followingUid != authUid()
        && edgeId == request.resource.data.followerUid + '_' + request.resource.data.followingUid;
      allow delete: if signedIn() && resource.data.followerUid == authUid();
      allow update: if false;
    }

    // ---- notifications ------------------------------------------------------
    match /notifications/{id} {
      // Recipient-only. Created exclusively by Functions.
      allow get, list: if signedIn() && resource.data.recipientUid == authUid();
      allow create: if false;

      // A recipient may only flip `readAt`; the body and target are immutable.
      allow update: if signedIn()
        && resource.data.recipientUid == authUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);

      allow delete: if false;
    }

    // ---- devices ------------------------------------------------------------
    match /devices/{uid} {
      // Your own push token, and nobody else's — Functions read it via the Admin
      // SDK, which bypasses these rules.
      allow get: if signedIn() && authUid() == uid;
      allow list: if false;
      allow create, update: if signedIn() && authUid() == uid;
      allow delete: if false;
    }
  }
}
